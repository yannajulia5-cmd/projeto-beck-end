  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Created": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "example": "Ana"
          },
          "surname": {
            "type": "string",
            "example": "Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "aluno@example.com"
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "firstname",
          "surname",
          "email"
        ]
      },
      "UserUpdate": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "example": "Ana"
          },
          "surname": {
            "type": "string",
            "example": "Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "aluno@example.com"
          }
        },
        "required": [
          "firstname",
          "surname",
          "email"
        ]
      },
      "UserCreate": {
        "type": "object",
        "properties": {
          "firstname": {
            "type": "string",
            "example": "Ana"
          },
          "surname": {
            "type": "string",
            "example": "Souza"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "aluno@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "Senha@123"
          },
          "confirmPassword": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "Senha@123"
          }
        },
        "required": [
          "firstname",
          "surname",
          "email",
          "password",
          "confirmPassword"
        ]
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "aluno@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "Senha@123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Token": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "CategoryInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tênis"
          },
          "slug": {
            "type": "string",
            "example": "tenis"
          },
          "use_in_menu": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Tênis"
          },
          "slug": {
            "type": "string",
            "example": "tenis"
          },
          "use_in_menu": {
            "type": "boolean",
            "example": true
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "slug"
        ]
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "name": {
            "type": "string",
            "example": "Tênis esportivo"
          },
          "slug": {
            "type": "string",
            "example": "tenis-esportivo"
          },
          "use_in_menu": {
            "type": "boolean"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 199.9
          },
          "price_with_discount": {
            "type": "number",
            "minimum": 0,
            "example": 149.9
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ImageInput"
            }
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OptionInput"
            }
          }
        },
        "required": [
          "name",
          "slug",
          "price",
          "price_with_discount"
        ]
      },
      "Product": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean",
            "example": true
          },
          "name": {
            "type": "string",
            "example": "Tênis esportivo"
          },
          "slug": {
            "type": "string",
            "example": "tenis-esportivo"
          },
          "use_in_menu": {
            "type": "boolean"
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 199.9
          },
          "price_with_discount": {
            "type": "number",
            "minimum": 0,
            "example": 149.9
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "content": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "title": {
                  "type": "string",
                  "example": "Tamanho"
                },
                "shape": {
                  "type": "string",
                  "enum": [
                    "square",
                    "circle"
                  ]
                },
                "radius": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^[0-9]+px$"
                    }
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "color"
                  ]
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "38",
                    "39"
                  ]
                }
              }
            }
          },
          "id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "slug",
          "price",
          "price_with_discount"
        ]
      },
      "ImageInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "deleted": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg",
              "image/jpg",
              "image/webp",
              "image/gif"
            ]
          },
          "content": {
            "type": "string",
            "description": "Base64 (até 2 MB decodificados) ou URL HTTP(S)."
          }
        }
      },
      "OptionInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "deleted": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "example": "Tamanho"
          },
          "shape": {
            "type": "string",
            "enum": [
              "square",
              "circle"
            ]
          },
          "radius": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+px$"
              }
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "color"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "38",
              "39"
            ]
          },
          "value": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Alias de values. Não envie os dois."
          }
        }
      },
      "CategoryPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "total": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
