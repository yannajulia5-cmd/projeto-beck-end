{
  "name": "digital-store-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST da Digital Store",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:undo": "sequelize-cli db:migrate:undo",
    "test": "jest --runInBand",
    "test:mysql": "jest --runInBand --testMatch **/tests/mysql.integration.js"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mysql2": "3.24.6",
    "sequelize": "6.37.8",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jest": "30.2.0",
    "nodemon": "3.1.10",
    "sequelize-cli": "6.6.3",
    "supertest": "7.1.4"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
